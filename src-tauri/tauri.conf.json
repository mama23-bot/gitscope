{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitScope",
  "version": "0.1.0",
  "identifier": "com.gitscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitScope",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0d13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "GitScope",
    "copyright": "Copyright © 2026 GitScope",
    "category": "DeveloperTool",
    "shortDescription": "Visual Git explorer and interactive Git learning hub",
    "longDescription": "GitScope helps you explore Git history visually and learn Git in a safe sandbox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
